# Copy to .env with Distribution/Server/install.sh. Values are configuration,
# not credentials; secret material lives under REPOPROMPT_SECRETS_DIR.
REPOPROMPT_SERVER_IMAGE=ghcr.io/repoprompt/repoprompt-server@sha256:REPLACE_WITH_RELEASE_DIGEST
REPOPROMPT_CONTAINER_NAME=repoprompt-server
REPOPROMPT_PROFILE=default
REPOPROMPT_TOPOLOGY=direct-tls
REPOPROMPT_HOSTNAME=localhost
REPOPROMPT_SERVER_PUBLIC_ORIGIN=https://localhost:9443
REPOPROMPT_BIND_HOST=0.0.0.0
REPOPROMPT_BIND_PORT=9443
REPOPROMPT_HEALTH_PORT=9080
REPOPROMPT_PORTAL_HOST=127.0.0.1
REPOPROMPT_PORTAL_PORT=off
REPOPROMPT_PUBLIC_ORIGIN=
REPOPROMPT_TRUSTED_PROXY_CIDRS=
REPOPROMPT_TLS_CERT_FILE=
REPOPROMPT_TLS_KEY_FILE=
REPOPROMPT_ENABLED_PROVIDERS=
REPOPROMPT_ENABLED_DIRECT_PROVIDERS=
REPOPROMPT_PROVIDER_VAULT_KEY_ID=provider-vault-v1
REPOPROMPT_PROJECT_SOURCE_POLICY_FILE=
REPOPROMPT_DATA_DIR=/var/lib/repoprompt-server
REPOPROMPT_SECRETS_DIR=/etc/repoprompt-server/secrets
REPOPROMPT_BACKUP_DIR=/var/backups/repoprompt-server
REPOPROMPT_PROVIDER_DIR=/opt/repoprompt-server/providers
