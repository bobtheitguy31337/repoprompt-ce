# syntax=docker/dockerfile:1.7
ARG ADMIN_NODE_VERSION=22.22.3
FROM node:${ADMIN_NODE_VERSION}-bookworm-slim AS admin-runtime

FROM swift:6.2.4-noble AS build
WORKDIR /src
COPY Package.swift Package.resolved ./
COPY Sources/RepoPromptServiceProtocol Sources/RepoPromptServiceProtocol
COPY Sources/RepoPromptShared Sources/RepoPromptShared
COPY Sources/RepoPromptDomainRuntime Sources/RepoPromptDomainRuntime
COPY Sources/RepoPromptC Sources/RepoPromptC
COPY Sources/RepoPromptAgentRuntimeCore Sources/RepoPromptAgentRuntimeCore
COPY Sources/RepoPromptWorkspaceRuntimeCore Sources/RepoPromptWorkspaceRuntimeCore
COPY Sources/RepoPromptRegexCore Sources/RepoPromptRegexCore
COPY Sources/RepoPromptCodeMapCore Sources/RepoPromptCodeMapCore
COPY Sources/CSwiftPCRE2 Sources/CSwiftPCRE2
COPY Sources/TreeSitterScannerSupport Sources/TreeSitterScannerSupport
COPY Sources/RepoPromptServicePersistence Sources/RepoPromptServicePersistence
COPY Sources/RepoPromptHeadlessRuntime Sources/RepoPromptHeadlessRuntime
COPY Sources/RepoPromptLinuxSupport Sources/RepoPromptLinuxSupport
COPY Sources/RepoPromptServiceHTTP Sources/RepoPromptServiceHTTP
COPY Sources/RepoPromptMCPAdapter Sources/RepoPromptMCPAdapter
COPY Sources/RepoPromptServerExecutable Sources/RepoPromptServerExecutable
COPY Tests/RepoPromptDomainRuntimeTests Tests/RepoPromptDomainRuntimeTests
COPY Tests/RepoPromptServerTests Tests/RepoPromptServerTests
RUN --mount=type=cache,target=/root/.cache/org.swift.swiftpm \
    --mount=type=cache,target=/src/.build \
    REPOPROMPT_SERVER_ONLY=1 swift build --disable-automatic-resolution -c release --product RepoPromptServer && \
    bin_path="$(swift build -c release --show-bin-path)" && \
    install -D -m 0755 "$bin_path/RepoPromptServer" /out/usr/local/bin/RepoPromptServer && \
    cp -a "$bin_path/RepoPromptCE_RepoPromptWorkspaceRuntimeCore.resources" /out/usr/local/bin/ && \
    install -d -m 0755 /out/usr/local/bin/RepoPromptCE_RepoPromptServiceHTTP.resources && \
    install -m 0644 "$bin_path/RepoPromptCE_RepoPromptServiceHTTP.resources/"* /out/usr/local/bin/RepoPromptCE_RepoPromptServiceHTTP.resources/

FROM swift:6.2.4-noble-slim
ARG ADMIN_NODE_VERSION
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl git tini util-linux && rm -rf /var/lib/apt/lists/* && \
    groupadd --gid 65532 repoprompt && useradd --uid 65532 --gid 65532 --home-dir /home/repoprompt --create-home --shell /usr/sbin/nologin repoprompt && \
    install -d -o 65532 -g 65532 /var/lib/repoprompt/state /var/lib/repoprompt/artifacts /srv/repoprompt/projects /srv/repoprompt/worktrees /var/cache/repoprompt
COPY --from=build /out/usr/local/bin/ /usr/local/bin/
COPY --from=admin-runtime /usr/local/bin/node /usr/local/bin/node
COPY Sandbox/Server/provider-cli-manager.sh /usr/local/libexec/repoprompt/provider-cli-manager
RUN chmod 0555 /usr/local/libexec/repoprompt/provider-cli-manager && \
    test "$(/usr/local/bin/node --version)" = "v${ADMIN_NODE_VERSION}"
ARG REPOPROMPT_COMMIT=unknown
ARG REPOPROMPT_VERSION=0.1.0
ARG REPOPROMPT_CREATED=1970-01-01T00:00:00Z
LABEL org.opencontainers.image.title="RepoPromptServer" \
      org.opencontainers.image.description="Durable internal RepoPrompt Agent and Workspace authority" \
      org.opencontainers.image.source="https://github.com/RepoPrompt/repoprompt-ce" \
      org.opencontainers.image.version="$REPOPROMPT_VERSION" \
      org.opencontainers.image.revision="$REPOPROMPT_COMMIT" \
      org.opencontainers.image.created="$REPOPROMPT_CREATED" \
      io.repoprompt.protocol-version="1" \
      io.repoprompt.schema-version="6" \
      io.repoprompt.runtime-uid="65532" \
      io.repoprompt.port.internal-api="9443/tcp;mtls" \
      io.repoprompt.port.portal="9081/tcp;http-password" \
      io.repoprompt.port.health="9080/tcp;loopback-only"
ENV REPOPROMPT_STATE_DB="/var/lib/repoprompt/state/repoprompt.sqlite" \
    REPOPROMPT_ARTIFACT_DIR="/var/lib/repoprompt/artifacts" \
    REPOPROMPT_PROJECT_DIR="/srv/repoprompt/projects" \
    REPOPROMPT_WORKTREE_DIR="/srv/repoprompt/worktrees" \
    REPOPROMPT_CACHE_DIR="/var/cache/repoprompt" \
    REPOPROMPT_PROVIDER_HOME_DIR="/tmp/repoprompt-provider-homes" \
    REPOPROMPT_PROVIDER_CLI_SELECTION_FILE="/var/lib/repoprompt/state/provider-cli-selection" \
    REPOPROMPT_PROVIDER_CLI_MANAGER="/usr/local/libexec/repoprompt/provider-cli-manager" \
    HOME="/home/repoprompt" \
    PATH="/home/repoprompt/.local/bin:/home/repoprompt/.opencode/bin:${PATH}"
USER 65532:65532
EXPOSE 9443 9081 9080
VOLUME ["/var/lib/repoprompt/state", "/var/lib/repoprompt/artifacts", "/srv/repoprompt/projects", "/srv/repoprompt/worktrees", "/var/cache/repoprompt"]
HEALTHCHECK --interval=10s --timeout=3s --start-period=15s --retries=6 CMD ["curl", "-fsS", "--max-time", "3", "http://127.0.0.1:9080/health/ready"]
ENTRYPOINT ["/usr/bin/tini", "-s", "--"]
CMD ["/usr/local/bin/RepoPromptServer"]
